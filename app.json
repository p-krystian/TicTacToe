{
  "expo": {
    "name": "TicTacToe",
    "slug": "TicTacToe",
    "version": "2.0.0-alpha",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./src/assets/brand/icon.png",
    "backgroundColor": "#131313",
    "primaryColor": "#dadada",
    "splash": {
      "image": "./src/assets/brand/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/brand/icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.TicTacToe"
    },
    "web": {
      "favicon": "./src/assets/brand/web.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
