{
  "expo": {
    "name": "TicTacToe",
    "slug": "TicTacToe",
    "version": "2.0.0-alpha",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "platforms": ["ios", "android", "web"],

    "icon": {
      "dark": "./assets/brand/icon.png",
      "light": "./assets/brand/icon-light.png",
      "tinted": "./assets/brand/icon-tinted.png"
    },
    "backgroundColor": "#131313",
    "primaryColor": "#dadada",

    "splash": {
      "image": "./assets/brand/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "favicon": "./assets/brand/web.png"
    }
  }
}
