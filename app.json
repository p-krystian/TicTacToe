{
  "expo": {
    "name": "TicTacToe",
    "slug": "TicTacToe",
    "version": "2.0.0",
    "newArchEnabled": true,
    "platforms": ["ios", "android", "web"],
    "icon": "./src/assets/brand/icon.png",
    "backgroundColor": "#131313",
    "splash": {
      "image": "./src/assets/brand/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#131313"
    },
    "ios": {
      "bundleIdentifier": "com.pkrystian.TicTacToe",
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.pkrystian.TicTacToe"
    },
    "web": {
      "favicon": "./src/assets/brand/web.png",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#dadada",
          "image": "./src/assets/brand/icon-light.png",
          "dark": {
            "image": "./src/assets/brand/icon.png",
            "backgroundColor": "#131313"
          },
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "baseUrl": "./",
      "reactCompiler": false
    }
  }
}
