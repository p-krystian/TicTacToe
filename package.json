{
  "name": "tictactoe",
  "private": true,
  "main": "index.ts",
  "version": "2.0.3",
  "description": "Simple TicTacToe game.",
  "repository": {
    "type": "git",
    "url": "https://github.com/p-krystian/TicTacToe/tree/native"
  },
  "author": "Krystian Piątek",
  "scripts": {
    "dev": "expo start",
    "dev:offline": "expo start --offline",
    "android": "expo run:android",
    "android:prod": "expo run:android --variant release",
    "web": "expo start --web",
    "web:prod": "expo export -p web",
    "electron": "concurrently \"expo start --web\" \"wait-on http://localhost:8081 && electron electron/main.js\"",
    "electron:prod": "pnpm run web:prod && electron-builder",
    "ios": "expo run:ios",
    "lint": "expo lint"
  },
  "build": {
    "appId": "com.tictactoe.app",
    "productName": "TicTacToe",
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sglara/cn": "^1.0.0",
    "expo": "^55.0.0",
    "expo-build-properties": "~55.0.12",
    "expo-font": "~55.0.6",
    "expo-splash-screen": "^55.0.16",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "^55.0.14",
    "i18next": "^25.10.9",
    "parse-duration": "^2.1.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-error-boundary": "^6.1.1",
    "react-i18next": "^16.6.6",
    "react-native": "0.83.4",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-svg": "~15.15.3",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.7.2",
    "tailwindcss": "^4.2.2",
    "uniwind": "^1.6.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.3",
    "wait-on": "^9.0.4"
  }
}
